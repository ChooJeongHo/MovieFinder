<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>

    <!-- OS 레벨 인증서 피닝 (OkHttp 앱 레벨 피닝의 방어 심층 레이어) -->
    <!-- expiration: 인증서 갱신 시 업데이트 필요 (cert-pin-check.yml CI 워크플로우 활용) -->
    <!-- api.themoviedb.org는 Amazon(ACM)이 발급 — 리프/중간 모두 장기간 안정적으로 관측됨 -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">themoviedb.org</domain>
        <domain includeSubdomains="true">tmdb.org</domain>
        <pin-set expiration="2027-06-30">
            <!-- api.themoviedb.org leaf -->
            <pin digest="SHA-256">QfyoR20v8hyYX7L+ikLzM/euPGSDl67gFFcor/sROMs=</pin>
            <!-- api.themoviedb.org intermediate: Amazon RSA 2048 M04 -->
            <pin digest="SHA-256">G9LNNAql897egYsabashkzUCTEJkWBzgoEtk8X/678c=</pin>
        </pin-set>
    </domain-config>

    <!-- image.tmdb.org는 Let's Encrypt가 발급(CDN 경유). 리프는 발급마다 키가 바뀌고(8/10·9/14·10/14 모두 다름)
         중간 CA는 YR1/YR2가 교대하며 YR3은 예고 없이 승격될 수 있는 백업이라, 리프 핀은 쓰지 않고
         루트 공개키 + 활성/백업 중간 CA를 핀한다(131일차, 2026-10-22 서버 체인 실측·공식 PEM 대조).
         NetworkModule.kt의 PIN_IMAGE_* 5개와 같은 값이어야 하며 cert-pin-check.yml이 일치를 비교한다.
         경위·갱신 절차: NETWORK_SECURITY_REPORT.md "2026-08-10 인증서 핀 불일치", "2026-10-22 image.tmdb.org 핀 재구성" 절 -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">image.tmdb.org</domain>
        <pin-set expiration="2027-06-30">
            <!-- ISRG Root X1 (기본 체인의 끝) -->
            <pin digest="SHA-256">C5+lpZ7tcVwmwQIMcRtPbsQtWLABXhQzejna0wHFr8M=</pin>
            <!-- ISRG Root YR (자체서명·X1 교차서명 모두 같은 키) -->
            <pin digest="SHA-256">fk6IOKit1ild5647BH06ujSIq5XbCgqlbYl6ANhhi88=</pin>
            <!-- Let's Encrypt 중간 CA YR1 (2026-10-22 서버가 보내는 중간 CA) -->
            <pin digest="SHA-256">LoMHBotttiDko50Gi13uXW71eIy7LAttI+rYT8wXF4w=</pin>
            <!-- Let's Encrypt 중간 CA YR2 (활성, 기존 핀 값 그대로) -->
            <pin digest="SHA-256">nWN7PSep5XDQdge5zK24CnCRXHr3KvzhKEGxsdqCX9E=</pin>
            <!-- Let's Encrypt 중간 CA YR3 (백업, 예고 없이 발급 시작 가능) -->
            <pin digest="SHA-256">UaqofZhLVZrGnpKfiIoCLYMuCJ/026CkErUQG8pLx5k=</pin>
        </pin-set>
    </domain-config>

    <!-- overridePins="true": 디버그 빌드에서 피닝 비활성화 (Charles Proxy 등 사용 가능) -->
    <debug-overrides overridePins="true">
        <trust-anchors>
            <certificates src="user"/>
        </trust-anchors>
    </debug-overrides>
</network-security-config>